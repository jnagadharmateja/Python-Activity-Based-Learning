[
  {
    "name": "Valid and rejected transactions",
    "input": "3\nD\n500\nW\n1200\nW\n400\n",
    "expected": [
      "Deposits: Rs 500.00",
      "Withdrawals: Rs 1200.00",
      "Rejected: 1",
      "Balance: Rs 300.00"
    ]
  },
  {
    "name": "Limit and invalid amount",
    "input": "2\nW\n6000\nD\n0\n",
    "expected": [
      "Rejected: 2",
      "Balance: Rs 1000.00"
    ]
  },
  {
    "name": "Non-finite and extra decimal amounts",
    "input": "3\nD\nnan\nD\ninf\nD\n1.234\n",
    "expected": [
      "Rejected: 3",
      "Balance: Rs 1000.00"
    ]
  },
  {
    "name": "Withdraw available balance",
    "input": "1\nW\n1000\n",
    "expected": [
      "Withdrawal accepted",
      "Balance: Rs 0.00"
    ]
  }
]
